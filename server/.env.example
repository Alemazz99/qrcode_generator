# Copia questo file in .env e adattalo.

# Porta su cui ascolta il servizio
PORT=8080

# URL pubblico del servizio, SENZA "/" finale. Finisce dentro ogni QR dinamico:
# una volta stampati i QR non va più cambiato.
#   in locale:            http://localhost:8080
#   prova col telefono:   http://192.168.1.50:8080 (IP del PC nella tua rete)
#   produzione:           https://q.tuodominio.it
BASE_URL=http://localhost:8080

# Database: con DATABASE_URL si usa Postgres (es. Supabase), altrimenti SQLite in DB_PATH.
# In produzione su piattaforme senza disco persistente (Koyeb, Render gratuito…)
# serve Postgres, perché il file SQLite verrebbe cancellato a ogni riavvio.
#   Supabase: Connect → "Session pooler" (IPv4), es.
#   postgresql://postgres.<progetto>:<password>@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
# DATABASE_URL=

# File del database SQLite, usato se DATABASE_URL è vuoto (la cartella viene creata se manca)
DB_PATH=data/qr.db

# Primo amministratore: usati SOLO al primo avvio, quando il database è vuoto.
# Dopo puoi toglierli; la password si cambia dalla dashboard.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=cambia-questa-password

# true se il servizio sta dietro un reverse proxy (Caddy, nginx) che imposta X-Forwarded-For
TRUST_PROXY=false

# Fuso orario per raggruppare le scansioni per giorno
TIMEZONE=Europe/Rome
